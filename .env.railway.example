# Paste into the APP service's Variables > Raw Editor in Railway.
# Add a PostgreSQL service named Postgres in the same Railway project first.
# If you use a different database service name, change the reference below.
DATABASE_URL=${{Postgres.DATABASE_URL}}
NODE_ENV=production
FRONTEND_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
ALLOWED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Railway supplies PORT. Keep the website and API in this one app service.
# No EXPO_PUBLIC_API_URL is needed: the website uses /api on its own origin.
# Optional: enable password reset emails by adding these two variables.
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=Habits <you@your-verified-domain.com>

# Optional web push reminders. Generate a stable pair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=your_public_key
# VAPID_PRIVATE_KEY=your_private_key
# VAPID_SUBJECT=mailto:you@your-domain.com
