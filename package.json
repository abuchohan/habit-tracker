{
  "name": "habit-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "expo-app",
    "server"
  ],
  "scripts": {
    "web": "npm run web --workspace expo-app",
    "server": "npm run dev --workspace server",
    "build:web": "npm run build:web --workspace expo-app",
    "typecheck": "npm run typecheck --workspace expo-app && npm run check-types --workspace server",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "npm run db:migrate --workspace server",
    "seed:local": "tsx scripts/seed-local.ts",
    "db:seed": "npm run db:seed --workspace server"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.20.6"
  }
}
